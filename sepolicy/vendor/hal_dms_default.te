# Dolby DMS HAL (vendor.dolby.hardware.dms@1.0-service) — ported from A13
# stock QTI policy (hal_dms_default domain). A16 platform/QTI policy no
# longer defines it; without a domain the service ran as init and could
# not register with hwservicemanager.
type hal_dms_default, domain;
type hal_dms_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_dms_default)
vndbinder_use(hal_dms_default)

# Register vendor.dolby.hardware.dms::IDms with hwservicemanager
binder_call(hal_dms_default, hwservicemanager)
allow hal_dms_default hal_dms_hwservice:hwservice_manager { add find };
allow hal_dms_default hidl_base_hwservice:hwservice_manager { add find };

# Audio HAL interface (stock A13 rule)
binder_call(hal_dms_default, hal_audio_default)

# Load vendor libs (libsqlite.vendor etc.) and dalvik-independent blobs
allow hal_dms_default vendor_file:file { map execute };

# /data/vendor/dolby cal/runtime files
allow hal_dms_default vendor_data_file:dir { create_dir_perms search };
allow hal_dms_default vendor_data_file:file create_file_perms;
