set_prop(vendor_init, vendor_power_prop)
set_prop(vendor_init, vendor_alarm_boot_prop)
set_prop(vendor_init, vendor_video_prop)
set_prop(vendor_init, vendor_fm_prop)

allow vendor_init {
  proc_dirty
  proc
}:file w_file_perms;

# vm.watermark_boost_factor set from init.target.rc (proactive reclaim
# headroom during video playback; vendor_init is denied the dedicated
# proc_watermark_boost_factor type otherwise)
allow vendor_init proc_watermark_boost_factor:file w_file_perms;

allow vendor_init block_device:lnk_file setattr;
allow vendor_init vendor_camera_prop:property_service set;

allow vendor_init input_device:chr_file { create setattr unlink rw_file_perms };

allow vendor_init persist_debug_prop:file read;

# vendor.mm.enable.qcom_parser / persist.backup.ntpServer (set from vendor
# scripts; default_prop set is neverallowed in platform policy — survives
# while SELINUX_IGNORE_NEVERALLOWS is enabled)
set_prop(vendor_init, vendor_mm_parser_prop)
allow vendor_init default_prop:property_service set;
allow vendor_init vendor_rawdump_block_device:lnk_file setattr;
