    <!--
        HALs whose service modules do NOT install a vintf_fragments on this A16
        build (so they must be declared here) — verified via ref/oops pmsg:
           - com.qualcomm.qti.dpm.api@1.0  -> "Cannot find entry ... in VINTF manifest"
          - android.hardware.usb@1.3      -> "Cannot register USB HAL service"
          - android.hardware.gnss: DELIBERATELY OMITTED. Declaring IGnss/default at any
            version (or multiple versions) makes the framework block-wait on it during
            boot (GnssNative.native_class_init_once -> 66s watchdog kill, boot never
            completes). The working reference ROM also does NOT declare gnss in its
            device VINTF manifest; framework getService() returns null (optional) and
            boot proceeds. GNSS location is unavailable (same as reference).
        graphics.composer@2.1-2.4 is NOT declared here: vendor.qti.hardware.display
        composer-service carries a `vintf_fragments` that installs the fragment to
        /vendor/etc/vintf/manifest/, and declaring it here conflicts at assemble_vintf.
    -->
    <hal format="hidl">
        <name>android.hardware.usb</name>
        <transport>hwbinder</transport>
        <version>1.3</version>
        <interface>
            <name>IUsb</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.3::IUsb/default</fqname>
    </hal>
    <!-- sensors@2.0 declared via vintf_fragments from @2.0-service.multihal module -->
    <hal format="hidl">
