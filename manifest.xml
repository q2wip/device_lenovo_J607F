<!--
    Full manifest from stock A13 vendor vintf/manifest.xml (523 lines).
    Restored after bringup minimal manifest — all HALs must be declared
    for hwservicemanager to accept registration; otherwise SIGABRT.

    Source: vendor_lenovo_J607Z/proprietary/vendor/etc/vintf/manifest.xml
    Changes from stock: sepolicy version 33.0 → 202504 (A16), + AIDL audio.core
-->
<manifest version="5.0" type="device" target-level="5">
