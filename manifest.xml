         A16 AudioFlinger crashes (SIGSEGV onFirstRef+684) trying to use
         the AIDL interface when HIDL @6.0 backend is present. -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <version>6.0</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
