<!--
    Bringup: minimal manifest — only essential HALs for boot.
    Non-core HIDL HALs (audio, bt, camera, wifi, sensors, ims, tether,
    dsp, vpp, qseecom, trustedui, livedisplay, iop, perf, etc.) removed
    to avoid timeouts crashing system_server.
    Runtime snapshot reference (Dimension2 A16) uses full 523-line manifest
    with all HIDL HALs; restore once bringup completes.
-->
<manifest version="5.0" type="device" target-level="5">
    <!-- AIDL HALs -->
    <hal format="aidl">
        <name>android.hardware.audio.core</name>
        <version>4</version>
        <interface>
            <name>IModule</name>
            <instance>default</instance>
        </interface>
        <fqname>IModule/default</fqname>
    </hal>
    <!-- HIDL HALs -->
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.0::IGatekeeper/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>4.1</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
        <fqname>@4.1::IKeymasterDevice/default</fqname>
    </hal>
</manifest>
